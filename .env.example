# ==========================================
# LibraryLens AI - Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Python MCP Server
MCP_SERVER_URL=http://127.0.0.1:5005

# Search & Live Research (SerpApi)
# Get your key at https://serpapi.com
SERPAPI_API_KEY=your_serpapi_api_key_here

# Google Gemini API
# Get your key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model Providers (Configurable - providers automatically become ENABLED when key is provided)
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=
TOGETHER_API_KEY=

# AI Model Discovery & Autonomous Research Engine
MODEL_SYNC_INTERVAL_HOURS=6
MAX_MODEL_RESEARCH_CONCURRENCY=2
MODEL_FRESH_HOURS=24
MODEL_AGING_HOURS=72

# MongoDB Connection
# Set your MongoDB URI or leave empty to use resilient embedded memory store
MONGODB_URI=mongodb://localhost:27017/librarylens

# Optional GitHub Token (increases rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=
